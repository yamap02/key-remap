#!/bin/sh
set -eu

# Package installation must not replace the app while an older Core can still
# hold physical keyboards. Do not turn an inability to inspect or stop launchd
# into a successful installation.
/bin/launchctl print system >/dev/null 2>&1 || {
    echo 'ReKey: cannot inspect the system launchd domain' >&2
    exit 1
}
# A running old UI could register the Core again during installation, while
# an old Agent could keep executing after its bundle has been replaced. Do
# not kill either process: ask the user to stop services and quit first.
for process in ReKey ReKeyAgent; do
    if /usr/bin/pgrep -x "$process" >/dev/null 2>&1; then
        echo "ReKey: $process is running; stop ReKey services and quit before installing" >&2
        exit 1
    else
        result=$?
        if [ "$result" -ne 1 ]; then
            echo "ReKey: cannot inspect $process processes" >&2
            exit 1
        fi
    fi
done
# The build replaces the first label with the validated product ID. Keep
# development-era labels so an initial pkg upgrade stops the older Core.
for service in @REKEY_CORE_LABEL@ jp.example.rekey.core jp.example.rekey.vhid; do
    if /bin/launchctl print "system/$service" >/dev/null 2>&1; then
        /bin/launchctl bootout "system/$service" || {
            echo "ReKey: failed to stop $service" >&2
            exit 1
        }
        if /bin/launchctl print "system/$service" >/dev/null 2>&1; then
            echo "ReKey: $service is still registered with launchd" >&2
            exit 1
        fi
    fi
done

# bootout may return before the process has fully exited. A conservative name
# check can also reject an unrelated same-named process; it never kills one.
for process in ReKey ReKeyAgent rekey-core rekey-vhid; do
    attempts=0
    while :; do
        if /usr/bin/pgrep -x "$process" >/dev/null 2>&1; then
            attempts=$((attempts + 1))
            if [ "$attempts" -ge 20 ]; then
                echo "ReKey: $process has not exited; refusing to replace the app" >&2
                exit 1
            fi
            /bin/sleep 0.5
        else
            result=$?
            if [ "$result" -ne 1 ]; then
                echo "ReKey: cannot inspect $process processes" >&2
                exit 1
            fi
            break
        fi
    done
done
